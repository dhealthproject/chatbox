# Build stage
FROM node:22.12.0-alpine AS builder

WORKDIR /app

# Dependencies first (layer cache)
COPY package.json package-lock.json ./
COPY patches/ ./patches/

RUN npm ci --prefer-offline --no-audit --ignore-scripts

# Application source (node_modules excluded via .dockerignore)
COPY . .

# Apply patches after full copy so host node_modules cannot overwrite patched deps
RUN npx patch-package --error-on-fail

# Fail build if Gemini thought-signature patches are missing from bundled dependencies
RUN grep -q "toolResult.thoughtSignature" node_modules/ai/dist/index.mjs && \
    grep -q "_thoughtSignatures" node_modules/@ai-sdk/openai-compatible/dist/index.mjs && \
    grep -q "part.thoughtSignature" node_modules/@ai-sdk/openai-compatible/dist/index.mjs

# Web production bundle (must match local `npm run build:web`)
ENV CHATBOX_BUILD_PLATFORM=web
RUN npm run build:web

# Production stage
FROM node:22.12.0-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/release/app/dist/renderer ./dist

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3002/ || exit 1

CMD ["serve", "-s", "dist", "-l", "3002"]